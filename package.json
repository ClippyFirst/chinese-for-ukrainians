{
  "name": "chinese-for-ukrainians",
  "private": true,
  "version": "0.1.0",
  "description": "Chinese to Ukrainian transcription utility for Ukrainian-speaking users.",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "validate:data": "node scripts/validate-data.mjs",
    "generate:data": "node scripts/generate-mappings.mjs",
    "test": "node scripts/test.mjs",
    "test:browser": "playwright test",
    "benchmark": "node scripts/benchmark.mjs",
    "check:release": "node scripts/release-check.mjs",
    "build": "npm run validate:data && npm run generate:data && vite build"
  },
  "dependencies": {
    "@pinyin-pro/data": "3.29.4",
    "pinyin-pro": "3.29.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.1"
  }
}
